{
  "name": "justcode",
  "version": "1.0.0",
  "description": "Local coding practice with Java and Python3 execution support",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start:backend": "npm start --workspace=backend",
    "clean": "node scripts/clean.cjs all",
    "clean:modules": "node scripts/clean.cjs modules",
    "clean:build": "node scripts/clean.cjs build",
    "test": "tsx --tsconfig frontend/tsconfig.json --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.node.json --noEmit --incremental false --composite false",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@playwright/test": "^1.65.1"
  },
  "keywords": [
    "leetcode",
    "coding",
    "java",
    "practice",
    "python3"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "dompurify": "^3.4.18",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}

{
    "compilerOptions": {
        // Enable project references so the frontend configuration can reference the Vite config project.
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "vite.config.ts"
    ]
}
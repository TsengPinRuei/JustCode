{
    "compilerOptions": {
        /* composite 專案讓前端根 tsconfig 可引用 Vite 設定的型別檢查。 */
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "vite.config.ts"
    ]
}